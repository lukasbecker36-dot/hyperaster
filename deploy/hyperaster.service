[Unit]
Description=Hyperaster equity-perp arb monitor
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/hyperaster
# Mode (paper/live) comes from HYPERASTER_MODE in this file, written by the
# control bot's /paper and /live commands. Missing file = paper (the default).
EnvironmentFile=-/opt/hyperaster/data/mode.env
ExecStart=/opt/hyperaster/.venv/bin/python live_monitor.py
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
